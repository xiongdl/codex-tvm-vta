# ~/.codex/rules/default.rules
#
# Policy:
# - Normal task-level Git work should run autonomously.
# - Broad staging, integration, remote, and destructive operations require
#   explicit human approval.
# - Force-push is forbidden for agents.

# ------------------------------------------------------------
# Read-only Git operations — AUTO
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Read-only Git operations are safe to run automatically.",
)

# ------------------------------------------------------------
# Task-level staging — AUTO
# ------------------------------------------------------------
#
# This allows explicit file staging, e.g.:
#   git add src/foo.ts tests/foo.test.ts
#
# More specific rules below override broad staging for "." and "-A".

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging files for the current task.",
)

# Broad staging requires human review.

prefix_rule(
    pattern = ["git", "add", "."],
    decision = "prompt",
    justification = "Broad staging may include changes unrelated to the current task.",
)

prefix_rule(
    pattern = ["git", "add", "-A"],
    decision = "prompt",
    justification = "Repository-wide staging may include unrelated changes.",
)

prefix_rule(
    pattern = ["git", "add", "--all"],
    decision = "prompt",
    justification = "Repository-wide staging may include unrelated changes.",
)

# ------------------------------------------------------------
# Task-level commits — AUTO
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow autonomous task-level local commits.",
)

# ------------------------------------------------------------
# Normal local branch operations — AUTO
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", "switch"],
    decision = "allow",
    justification = "Allow normal local branch switching and creation.",
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "allow",
    justification = "Allow normal local checkout operations.",
)

prefix_rule(
    pattern = ["git", "branch"],
    decision = "allow",
    justification = "Allow normal local branch management.",
)

# ------------------------------------------------------------
# Integration / history changes — HUMAN APPROVAL
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", "merge"],
    decision = "prompt",
    justification = "Branch integration requires explicit human approval.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "History rewriting requires explicit human approval.",
)

# ------------------------------------------------------------
# Remote operations — HUMAN APPROVAL
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing local changes to a remote requires explicit human approval.",
)

# Force-push — FORBIDDEN

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Agents must never force-push automatically.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Agents must never force-push automatically.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Agents must not rewrite remote history.",
)

# ------------------------------------------------------------
# Destructive local operations — HUMAN APPROVAL
# ------------------------------------------------------------

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset can permanently discard local changes.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can permanently delete untracked files.",
)
