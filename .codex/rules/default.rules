# Repository Git policy
#
# `.agents/custom/scripts/git-workflow` is the only write entry point.
# Read-only Git stays autonomous. Direct mutations are gated so the script's
# allowlist, snapshot, clean-state, and submodule checks cannot be bypassed.

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Read-only Git operations are safe to run automatically.",
)

# Workflow-local, non-publishing operations.

prefix_rule(
    pattern = ["./.agents/custom/scripts/git-workflow", "status"],
    decision = "allow",
    justification = "The workflow status command is read-only.",
)

prefix_rule(
    pattern = ["./.agents/custom/scripts/git-workflow", "create"],
    decision = "allow",
    justification = "The workflow validates clean state and creates only the approved task branch.",
)

prefix_rule(
    pattern = ["./.agents/custom/scripts/git-workflow", "commit"],
    decision = "allow",
    justification = "The workflow enforces exact paths, submodule propagation, commit OIDs, and clean state.",
)

# Remote, integration, and cleanup operations retain explicit approval.

prefix_rule(
    pattern = ["./.agents/custom/scripts/git-workflow", ["pull", "push", "merge", "delete"]],
    decision = "prompt",
    justification = "Remote updates, publication, integration, and branch cleanup require explicit Root authorization.",
)

# Direct mutations bypass the repository workflow and are forbidden.

prefix_rule(
    pattern = ["git", ["add", "am", "apply", "branch", "checkout", "cherry-pick", "clean", "commit", "fetch", "merge", "mv", "notes", "pull", "push", "rebase", "reset", "restore", "revert", "rm", "stash", "switch", "tag", "update-ref", "worktree"]],
    decision = "forbidden",
    justification = "Use ./.agents/custom/scripts/git-workflow instead of direct Git mutation commands.",
)

prefix_rule(
    pattern = ["git", "submodule", ["add", "deinit", "set-branch", "set-url", "sync", "update"]],
    decision = "forbidden",
    justification = "Use ./.agents/custom/scripts/git-workflow instead of direct submodule mutations.",
)
