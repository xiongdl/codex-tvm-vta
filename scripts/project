#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$script_dir")
failures=0
warnings=0
expected_url_tvm=https://github.com/xiongdl/tvm.git
expected_branch_tvm=tvm_v0.17.0
expected_url_vta=https://github.com/xiongdl/vta.git
expected_branch_vta=vta_v0.0.2

usage() {
  cat <<'EOF'
Project automation entry point.

Commands:
  help     Show this help.
  status   Report workspace and submodule reproducibility status.
  verify   Validate workspace and submodule reproducibility invariants.

Not configured:
  setup
  build
  test
  clean
EOF
}

git_value() { git config -f "$project_root/.gitmodules" --get "$1" 2>/dev/null || true; }

tree_state() {
  repo=$1
  ignore_submodules=${2:-none}
  if [ ! -d "$repo" ] || ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '%s\n' NOT_INITIALIZED
  elif [ -n "$(git -C "$repo" status --porcelain --ignore-submodules="$ignore_submodules" 2>/dev/null)" ]; then
    printf '%s\n' DIRTY
  else
    printf '%s\n' CLEAN
  fi
}

workspace_details() {
  workspace_branch=$(git -C "$project_root" symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s' DETACHED)
  workspace_head=$(git -C "$project_root" rev-parse HEAD 2>/dev/null || printf '%s' UNAVAILABLE)
  workspace_porcelain=$(git -C "$project_root" status --porcelain --ignore-submodules=all 2>/dev/null || true)
  workspace_state=$(tree_state "$project_root" all)
  workspace_staged=NO; workspace_unstaged=NO; workspace_untracked=NO
  if printf '%s\n' "$workspace_porcelain" | grep -q '^??'; then workspace_untracked=YES; fi
  if printf '%s\n' "$workspace_porcelain" | grep -q '^[MADRCU]'; then workspace_staged=YES; fi
  if printf '%s\n' "$workspace_porcelain" | grep -q '^.[MADRCU]'; then workspace_unstaged=YES; fi
}

submodule_details() {
  name=$1; expected_url=$2; expected_branch=$3
  configured_path=$(git_value "submodule.$name.path")
  configured_url=$(git_value "submodule.$name.url")
  configured_branch=$(git_value "submodule.$name.branch")
  submodule_path=$project_root/$configured_path
  gitlink=$(git -C "$project_root" ls-tree HEAD -- "$configured_path" 2>/dev/null | awk '$1 == "160000" {print $3}')
  submodule_head=UNAVAILABLE; submodule_branch=UNAVAILABLE; submodule_state=NOT_INITIALIZED; gitlink_match=NO
  if [ -n "$configured_path" ] && git -C "$submodule_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    submodule_head=$(git -C "$submodule_path" rev-parse HEAD 2>/dev/null || printf '%s' UNAVAILABLE)
    submodule_branch=$(git -C "$submodule_path" symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s' DETACHED)
    submodule_state=$(tree_state "$submodule_path")
  fi
  if [ -n "$gitlink" ] && [ "$gitlink" = "$submodule_head" ]; then gitlink_match=YES; fi
}

print_submodule() {
  label=$1; name=$2; expected_url=$3; expected_branch=$4
  submodule_details "$name" "$expected_url" "$expected_branch"
  display_path=${configured_path:-NOT_CONFIGURED}; display_url=${configured_url:-NOT_CONFIGURED}
  display_branch=${configured_branch:-NOT_CONFIGURED}; display_gitlink=${gitlink:-UNAVAILABLE}
  cat <<EOF
$label:
  Path: $display_path
  Expected URL: $expected_url
  Configured URL: $display_url
  Default Branch: $display_branch
  Expected Default Branch: $expected_branch
  Gitlink: $display_gitlink
  HEAD: $submodule_head
  Branch: $submodule_branch
  Working Tree: $submodule_state
  Gitlink Match: $gitlink_match
EOF
}

evaluate_submodule() {
  name=$1; expected_path=$2; expected_url=$3; expected_branch=$4
  submodule_details "$name" "$expected_url" "$expected_branch"
  if [ "$configured_path" != "$expected_path" ]; then failures=$((failures + 1)); fi
  if [ "$configured_url" != "$expected_url" ]; then failures=$((failures + 1)); fi
  if [ "$configured_branch" != "$expected_branch" ]; then failures=$((failures + 1)); fi
  if [ -z "$gitlink" ] || [ "$gitlink_match" != YES ]; then failures=$((failures + 1)); fi
  if [ "$submodule_state" != CLEAN ]; then failures=$((failures + 1)); fi
  if [ "$submodule_branch" != DETACHED ] && [ "$submodule_branch" != UNAVAILABLE ] && [ "$submodule_branch" != "$expected_branch" ]; then warnings=$((warnings + 1)); fi
}

evaluate() {
  failures=0; warnings=0
  for required in README.md docs/ARCHITECTURE.md docs/PROJECT_STATUS.md docs/REPRODUCIBILITY.md scripts/project .gitmodules; do
    if [ ! -e "$project_root/$required" ]; then failures=$((failures + 1)); fi
  done
  if ! git -C "$project_root" rev-parse --show-toplevel >/dev/null 2>&1; then failures=$((failures + 1)); return; fi
  if ! git config -f "$project_root/.gitmodules" --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1; then failures=$((failures + 1)); fi
  workspace_details
  if [ "$workspace_state" != CLEAN ]; then failures=$((failures + 1)); fi
  evaluate_submodule tvm tvm "$expected_url_tvm" "$expected_branch_tvm"
  evaluate_submodule vta vta "$expected_url_vta" "$expected_branch_vta"
}

status_command() {
  if ! git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then echo "NOT_CONFIGURED: scripts/project is not inside a Git workspace." >&2; exit 2; fi
  workspace_details
  cat <<EOF
Workspace:
  Branch: $workspace_branch
  HEAD: $workspace_head
  Working Tree: $workspace_state
  Staged Changes: $workspace_staged
  Unstaged Changes: $workspace_unstaged
  Untracked Files: $workspace_untracked
EOF
  print_submodule TVM tvm "$expected_url_tvm" "$expected_branch_tvm"
  print_submodule VTA vta "$expected_url_vta" "$expected_branch_vta"
  evaluate
  overall=READY
  if [ "$failures" -gt 0 ]; then overall=NOT_READY; elif [ "$warnings" -gt 0 ]; then overall=WARNING; fi
  printf 'Overall:\n  Status: %s\n  Failures: %s\n  Warnings: %s\n' "$overall" "$failures" "$warnings"
}

verify_command() {
  evaluate
  if [ "$failures" -gt 0 ]; then printf 'VERIFY: FAIL (%s invariant failure(s), %s warning(s))\n' "$failures" "$warnings"; exit 1; fi
  printf 'VERIFY: PASS (%s warning(s))\n' "$warnings"
}

cmd=${1:-help}
if [ "$#" -gt 1 ]; then usage >&2; exit 2; fi
case "$cmd" in
  help|-h|--help) usage ;;
  status) status_command ;;
  verify) verify_command ;;
  setup|build|test|clean) echo "Command '$cmd' is not configured for this project yet." >&2; exit 2 ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
