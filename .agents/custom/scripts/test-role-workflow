#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd
)"
CUSTOM_DIR="$(dirname "$SCRIPT_DIR")"

require_text() {
    local file="$1"
    local expected="$2"

    grep -F -- "$expected" "$file" >/dev/null || {
        printf 'FAIL missing-text file=%s text=%s\n' \
            "${file#"$CUSTOM_DIR"/}" \
            "$expected" >&2
        exit 1
    }
}

ROOT="$CUSTOM_DIR/root.md"
DEFAULT="$CUSTOM_DIR/default.md"
ARCH_REVIEWER="$CUSTOM_DIR/architecture-reviewer.md"
IMPL_REVIEWER="$CUSTOM_DIR/implementation-reviewer.md"

require_text "$ROOT" 'skills/interview-me/SKILL.md'
require_text "$ROOT" 'skills/spec-driven-development/SKILL.md'
require_text "$ROOT" 'skills/planning-and-task-breakdown/SKILL.md'
require_text "$ROOT" 'YYYYMMDD-<kebab-case-slug>'
require_text "$ROOT" 'Branch creation happens before Interview.'
require_text "$ROOT" '**Spec approval gate**'
require_text "$ROOT" '**Plan/Tasks approval gate**'
require_text "$ROOT" 'Implementation Reviewer `Pass` completes the lifecycle'
require_text "$ROOT" 'The user owns the optional merge'
require_text "$ROOT" 'exact per-repository base-to-tip range'
require_text "$ROOT" 'For each checkpoint in `TASKS.md`, dispatch a fresh Default'
require_text "$ROOT" 'Route actionable `Implementation findings` to a fresh Default'
require_text "$ROOT" 'wait for the delegated agent to return before continuing'
require_text "$ROOT" 'Do not interrupt, cancel, replace, parallelize, message, or take over'
require_text "$ROOT" 'keep that Default assigned to its current'
require_text "$ROOT" 'all task, fix, and handoff commit maps'

require_text "$DEFAULT" 'skills/incremental-implementation/SKILL.md'
require_text "$DEFAULT" 'skills/test-driven-development/SKILL.md'
require_text "$DEFAULT" 'For a `TASKS.md` checkpoint'
require_text "$DEFAULT" 'For Implementation Review findings'
require_text "$DEFAULT" 'each task is a local'
require_text "$DEFAULT" '## Escalation handoff'
require_text "$DEFAULT" '`wip:` handoff'

require_text "$ARCH_REVIEWER" 'skills/api-and-interface-design/SKILL.md'
require_text "$ARCH_REVIEWER" '`Architecture Review`'
require_text "$ARCH_REVIEWER" '`Plan Conformance Review`'
require_text "$ARCH_REVIEWER" 'Return exactly one verdict'

require_text "$ROOT" 'For both Architecture Reviewer scopes, include unambiguous repository/path to'
require_text "$ROOT" 'state its provenance and confirmation.'

require_text "$ARCH_REVIEWER" 'Review committed inputs only.'
require_text "$ARCH_REVIEWER" 'For `Architecture Review`, Root supplies the initiative id, confirmed'
require_text "$ARCH_REVIEWER" 'For `Plan Conformance Review`, Root supplies the initiative id, approved'
require_text "$ARCH_REVIEWER" 'Use the first matching row.'
require_text "$ARCH_REVIEWER" 'Re-review at new OIDs repeats the full workflow.'
require_text "$ARCH_REVIEWER" 'Before `Pass`, verify every distinct material current-state claim'
require_text "$ARCH_REVIEWER" '`GREEN` means applicable repository-required checks pass'
require_text "$ARCH_REVIEWER" 'An existing or confirmed in-scope consumer justifies a surface; a hypothetical'
require_text "$ARCH_REVIEWER" '## Output contract'
require_text "$ARCH_REVIEWER" 'consequence, correction owner, and the smallest'
require_text "$ARCH_REVIEWER" '## Architecture Review checks'
require_text "$ARCH_REVIEWER" '1. **Intent and completeness:**'
require_text "$ARCH_REVIEWER" '2. **Ownership and modularity:**'
require_text "$ARCH_REVIEWER" '3. **Dependencies and contracts:**'
require_text "$ARCH_REVIEWER" '4. **Simplicity:**'
require_text "$ARCH_REVIEWER" '5. **Change locality:**'
require_text "$ARCH_REVIEWER" '6. **Feasibility:**'
require_text "$ARCH_REVIEWER" '## Plan Conformance Review checks'
require_text "$ARCH_REVIEWER" '1. **Coverage and conformance:**'
require_text "$ARCH_REVIEWER" '2. **Executability and cohesion:**'
require_text "$ARCH_REVIEWER" '3. **Order and checkpoints:**'
require_text "$ARCH_REVIEWER" '4. **Verification:**'
require_text "$ARCH_REVIEWER" '5. **Risk and locality:**'
require_text "$ARCH_REVIEWER" '6. **End state:**'

require_text "$IMPL_REVIEWER" 'skills/code-review-and-quality/SKILL.md'
require_text "$IMPL_REVIEWER" 'Review committed state only.'
require_text "$IMPL_REVIEWER" 'Direct Git inspection is read-only'
require_text "$IMPL_REVIEWER" 'Return exactly one verdict'

printf 'OK role workflow contract\n'
